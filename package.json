{
  "name": "mute-vr",
  "private": true,
  "version": "0.1.0",
  "description": "MUTE \u2014 a co-op VR horror game where the monster hears your voice and your hands do the talking.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https --host",
    "build": "npm run typecheck && vite build && node scripts/optimize-assets.mjs dist",
    "dev:ktx2": "MUTE_KTX2=1 vite",
    "assets:ktx2": "node scripts/optimize-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "assets": ".blender-venv/bin/python art/build.py",
    "test:e2e": "node tests/e2e/smoke.cjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "peerjs": "^1.5.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "ktx2-encoder": "^0.6.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
